rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Board Settings & Form Builder Mapping
    match /settings/config {
      // Intake form needs to read the config to build the dynamic form
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Auto-Incrementing Ticket Counters
    match /counters/tickets {
      // Both Intake Form and Board need to interact with the ticket counter transaction
      allow read, update: if true;
      allow create: if request.auth != null;
    }

    // The core Kanban Cards
    match /cards/{card} {
      allow read, update, delete: if request.auth != null;
      // Allow public creation but ONLY for new Incoming cards
      allow create: if request.auth != null || request.resource.data.status == 'Incoming';
    }
  }
}
